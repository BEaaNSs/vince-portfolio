# Add these as separate Variables in Railway; do not upload a real .env file.
APP_NAME="Vince Portfolio"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_WITH_OUTPUT_FROM_php_artisan_key_generate_--show
APP_URL=https://YOUR-GENERATED-DOMAIN.up.railway.app
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
# No database is required for the current read-only portfolio pages.
# Keep existing local Laravel DB settings out of your public repository.
